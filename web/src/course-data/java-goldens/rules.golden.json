      "eq" : [ {
        "read" : "employment"
      }, {
        "enum" : "RETIRED"
      } ]
    }, {
      "cmp" : ">",
      "l" : {
        "read" : "loan.term"
      },
      "r" : {
        "int" : 240
      }
    } ]
  }
